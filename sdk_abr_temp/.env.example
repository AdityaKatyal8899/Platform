# CoWatch SDK — configuration (COPY TO .env AND FILL IN; .env MUST BE GITIGNORED)
# Predefined variable names are a published contract. NEVER commit real secrets.

# --- Storage (your object store) ---
STORAGE_BACKEND=s3
S3_BUCKET=your-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=xxxxxxxx
S3_SECRET=xxxxxxxx
# Optional: for R2 / MinIO / S3-compatible stores
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com

# --- Delivery / CDN (your CDN in front of the bucket) ---
CDN_URL=https://cdn.your-domain.com
# DELIVERY_URL_TEMPLATE={cdn}/videos/{video_id}/stream.m3u8

# --- Queue (optional glue) ---
# inline  -> process synchronously in the calling process
# celery  -> enqueue to a broker (set CELERY_BROKER_URL)
QUEUE_BACKEND=inline
# CELERY_BROKER_URL=redis://localhost:6379/0

# --- Result signal (the SDK EMITS; you persist to YOUR database) ---
# webhook -> POST result JSON to RESULT_WEBHOOK_URL
# logging -> print to stderr (dev / smoke tests)
# callback -> set programmatically (config.result_sink); cannot come from env
RESULT_BACKEND=webhook
RESULT_WEBHOOK_URL=https://your-backend.example.com/api/cowatch/result

# --- HLS / transcode (usually leave defaults) ---
# HLS_SEGMENT_SECONDS=4
# HLS_LIST_SIZE=0
# HLS_PLAYLIST_TYPE=vod
# KEYFRAME_INTERVAL=2.0
# AUDIO_BITRATE=128k
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# --- Runtime ---
# TEMP_DIR=storage/videos
# UPLOAD_WINDOW=10
# PREPLAY_THRESHOLD=0.30
# RETRY_ATTEMPTS=5
# RETRY_BACKOFF=1.0
